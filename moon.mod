name = "cosettese/moonastrofits"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/cosettese/MoonAstroFITS"

license = "Apache-2.0"

keywords = [ "fits", "astronomy", "scientific-data", "binary-format" ]

preferred_target = "wasm-gc"

description = "A pure MoonBit FITS astronomy data parser, validator, and toolkit."
